{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "espacioauditorium.com.ar"
        }
      ],
      "destination": "https://www.espacioauditorium.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.espacioauditorium.com.ar/:path",
      "permanent": true
    },
    {
      "source": "/salas-conferencias-eventos-profesionales-buenos-aires",
      "destination": "/salas",
      "permanent": true
    },
    {
      "source": "/salas-conferencias-eventos-profesionales-buenos-aires/",
      "destination": "/salas",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin-auth",
      "destination": "/api/admin?action=auth"
    },
    {
      "source": "/api/admin-blocked-dates",
      "destination": "/api/admin?action=blocked-dates"
    },
    {
      "source": "/api/admin-cancel",
      "destination": "/api/admin?action=cancel"
    },
    {
      "source": "/api/admin-reservations",
      "destination": "/api/admin?action=reservations"
    },
    {
      "source": "/api/admin-wa-conversations",
      "destination": "/api/admin?action=wa-conversations"
    },
    {
      "source": "/api/reservations/:id",
      "destination": "/api/reservations/[id]"
    },
    {
      "source": "/salas",
      "destination": "/salas/index.html"
    },
    {
      "source": "/cotizar",
      "destination": "/cotizar/index.html"
    },
    {
      "source": "/conferencias",
      "destination": "/conferencias/index.html"
    },
    {
      "source": "/capacitaciones",
      "destination": "/capacitaciones/index.html"
    },
    {
      "source": "/podcast-y-streaming",
      "destination": "/podcast-y-streaming/index.html"
    },
    {
      "source": "/lanzamientos",
      "destination": "/lanzamientos/index.html"
    },
    {
      "source": "/((?!api/|img/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://www.googletagmanager.com https://www.google-analytics.com https://cdn.fromdoppler.com https://*.fromdoppler.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.fromdoppler.com https://*.fromdoppler.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://www.facebook.com https://*.fromdoppler.com https://challenges.cloudflare.com; frame-src https://my.matterport.com https://www.google.com https://challenges.cloudflare.com https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://www.mercadopago.com.ar https://*.mercadopago.com https://*.fromdoppler.com; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/availability",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/((?!availability$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/keep-alive",
      "schedule": "0 9 * * *"
    }
  ]
}
